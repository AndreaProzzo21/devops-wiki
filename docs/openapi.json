{
  "openapi": "3.1.0",
  "info": {
    "title": "DevOps Command Wiki API",
    "description": "\nCentralized API for navigating, searching, and retrieving DevOps commands, deployment scripts, and infrastructure snippets.\nProvides rate-limited search capabilities and paginated access to the command database.\n    ",
    "contact": {
      "name": "DevOps Team"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/api/search": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Search for commands",
        "description": "Perform a rate-limited, full-text search across all commands. Results can be optionally filtered by tool and category.",
        "operationId": "search_api_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "The search query string. Matches against command name, summary, and description.",
              "title": "Q"
            },
            "description": "The search query string. Matches against command name, summary, and description."
          },
          {
            "name": "tool",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional tool name to filter results (e.g., 'kubectl', 'docker').",
              "title": "Tool"
            },
            "description": "Optional tool name to filter results (e.g., 'kubectl', 'docker')."
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional category name to filter results within a tool.",
              "title": "Category"
            },
            "description": "Optional category name to filter results within a tool."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Maximum number of search results to return.",
              "default": 20,
              "title": "Limit"
            },
            "description": "Maximum number of search results to return."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CommandSummary"
                  },
                  "title": "Response Search Api Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/commands": {
      "get": {
        "tags": [
          "Commands"
        ],
        "summary": "List all commands",
        "description": "Retrieve a paginated list of all available commands. Can be filtered by specific tools or categories.",
        "operationId": "list_commands_api_commands_get",
        "parameters": [
          {
            "name": "tool",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter the list by a specific tool.",
              "title": "Tool"
            },
            "description": "Filter the list by a specific tool."
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter the list by a specific category.",
              "title": "Category"
            },
            "description": "Filter the list by a specific category."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "The page number to retrieve for pagination.",
              "default": 1,
              "title": "Page"
            },
            "description": "The page number to retrieve for pagination."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Number of items to return per page.",
              "default": 20,
              "title": "Limit"
            },
            "description": "Number of items to return per page."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/commands/{cmd_id}": {
      "get": {
        "tags": [
          "Commands"
        ],
        "summary": "Get command details",
        "description": "Retrieve the full details, flags, and examples of a specific command using its unique identifier.",
        "operationId": "get_command_api_commands__cmd_id__get",
        "parameters": [
          {
            "name": "cmd_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The unique identifier of the command (e.g., 'kubectl-get-pods').",
              "title": "Cmd Id"
            },
            "description": "The unique identifier of the command (e.g., 'kubectl-get-pods')."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandDetail"
                }
              }
            }
          },
          "404": {
            "description": "Command not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tools": {
      "get": {
        "tags": [
          "Metadata"
        ],
        "summary": "List available tools",
        "description": "Retrieve a complete list of all tools documented in the wiki, including their available categories and total command counts.",
        "operationId": "tools_api_tools_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {

                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CommandDetail": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "Id"
          },
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "syntax": {
            "type": "string",
            "title": "Syntax"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "flags": {
            "items": {
              "$ref": "#/components/schemas/Flag"
            },
            "type": "array",
            "title": "Flags",
            "default": []
          },
          "examples": {
            "items": {
              "$ref": "#/components/schemas/Example"
            },
            "type": "array",
            "title": "Examples",
            "default": []
          },
          "keywords": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Keywords",
            "default": []
          },
          "related": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Related",
            "default": []
          },
          "danger": {
            "type": "string",
            "enum": [
              "none",
              "caution",
              "destructive"
            ],
            "title": "Danger",
            "default": "none"
          },
          "related_commands": {
            "items": {
              "$ref": "#/components/schemas/CommandSummary"
            },
            "type": "array",
            "title": "Related Commands",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "tool",
          "category",
          "name",
          "syntax",
          "summary"
        ],
        "title": "CommandDetail"
      },
      "CommandPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CommandSummary"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "pages": {
            "type": "integer",
            "title": "Pages"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "pages",
          "limit"
        ],
        "title": "CommandPage"
      },
      "CommandSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "danger": {
            "type": "string",
            "title": "Danger"
          }
        },
        "type": "object",
        "required": [
          "id",
          "tool",
          "category",
          "name",
          "summary",
          "danger"
        ],
        "title": "CommandSummary"
      },
      "Example": {
        "properties": {
          "cmd": {
            "type": "string",
            "title": "Cmd"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "cmd",
          "description"
        ],
        "title": "Example"
      },
      "Flag": {
        "properties": {
          "flag": {
            "type": "string",
            "title": "Flag"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "flag",
          "description"
        ],
        "title": "Flag"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}